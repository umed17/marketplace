# ─── Local development (Docker Postgres) ───
DATABASE_URL="postgresql://usto:usto@localhost:5432/usto?schema=public"
DIRECT_DATABASE_URL="postgresql://usto:usto@localhost:5432/usto?schema=public"

# ─── Neon (production) ───
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# DIRECT_DATABASE_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# JWT — same secret on Vercel AND Railway
JWT_SECRET="change-me-to-a-long-random-secret"

# Public frontend URL (Vercel)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Backend API URL — set ONLY on Vercel (points to Railway)
# BACKEND_URL="https://your-app.up.railway.app"

# File uploads (Railway: mount volume at /data/uploads)
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB="8"

# Seed admin (used only by prisma/seed.ts)
ADMIN_EMAIL="admin@usto.tj"
ADMIN_PHONE="+992900000000"
ADMIN_PASSWORD="Admin123!"
