# Neon — барои Railway DATABASE_URL-ро Direct URL гузоред (бе -pooler)
DATABASE_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Ихтиёрӣ: агар Pooled истифода мебаред, барои migrate Direct URL лозим мешавад
# DIRECT_DATABASE_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Supabase Auth (email OTP on signup)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# JWT — same secret on Vercel AND Railway
JWT_SECRET="change-me-to-a-long-random-secret"

# Public frontend URL (Vercel)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Backend API URL — set ONLY on Vercel (points to Railway)
# BACKEND_URL="https://your-app.up.railway.app"

# File uploads (Railway: mount volume at /data/uploads)
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB="8"

# Seed admin (used only by prisma/seed.ts)
ADMIN_EMAIL="admin@usto.tj"
ADMIN_PHONE="+992900000000"
ADMIN_PASSWORD="Admin123!"
