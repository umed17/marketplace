{
  "name": "usto-marketplace",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "description": "Биржаи хизматрасонӣ барои устоҳо ва муштариён",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:clean": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\" && next dev --turbopack",
    "build": "next build",
    "build:backend": "prisma generate && next build",
    "build:frontend": "prisma generate && next build",
    "start": "next start",
    "start:backend": "prisma migrate deploy && next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "@tailwindcss/postcss": "^4.1.12",
    "bcryptjs": "^3.0.2",
    "jose": "^6.0.12",
    "lucide-react": "^1.33.0",
    "next": "^15.5.2",
    "prisma": "^6.14.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.8",
    "eslint": "^9.34.0",
    "eslint-config-next": "^15.5.2",
    "tsx": "^4.20.5"
  }
}
